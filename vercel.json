{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-us", "destination": "/#about", "permanent": true },
    { "source": "/contact-us", "destination": "/#contact", "permanent": true },
    { "source": "/private-shuttle/routes", "destination": "/#routes", "permanent": true },

    { "source": "/private-shuttle/sjo-airport/la-fortuna-arenal", "destination": "/shuttle/san-jose-airport-to-la-fortuna", "permanent": true },
    { "source": "/private-shuttle/sjo-airport/manuel-antonio", "destination": "/shuttle/san-jose-airport-to-manuel-antonio", "permanent": true },
    { "source": "/private-shuttle/sjo-airport/monteverde", "destination": "/shuttle/san-jose-airport-to-monteverde", "permanent": true },
    { "source": "/private-shuttle/sjo-airport/tamarindo", "destination": "/shuttle/san-jose-airport-to-tamarindo", "permanent": true },
    { "source": "/private-shuttle/sjo-airport/jaco", "destination": "/shuttle/san-jose-airport-to-jaco", "permanent": true },
    { "source": "/private-shuttle/sjo-airport/puerto-viejo", "destination": "/shuttle/san-jose-airport-to-puerto-viejo", "permanent": true },
    { "source": "/private-shuttle/sjo-airport/uvita", "destination": "/shuttle/san-jose-airport-to-uvita", "permanent": true },
    { "source": "/private-shuttle/lir-airport/la-fortuna-arenal", "destination": "/shuttle/liberia-airport-to-la-fortuna", "permanent": true },
    { "source": "/private-shuttle/lir-airport/tamarindo", "destination": "/shuttle/liberia-airport-to-tamarindo", "permanent": true },
    { "source": "/private-shuttle/lir-airport/monteverde", "destination": "/shuttle/liberia-airport-to-monteverde", "permanent": true },
    { "source": "/private-shuttle/lir-airport/manuel-antonio", "destination": "/shuttle/liberia-airport-to-manuel-antonio", "permanent": true },
    { "source": "/private-shuttle/lir-airport/playa-flamingo", "destination": "/shuttle/liberia-airport-to-playa-flamingo", "permanent": true },
    { "source": "/private-shuttle/lir-airport/playa-conchal", "destination": "/shuttle/liberia-airport-to-playa-conchal", "permanent": true },
    { "source": "/private-shuttle/lir-airport/nosara", "destination": "/shuttle/liberia-airport-to-nosara", "permanent": true },
    { "source": "/private-shuttle/lir-airport/santa-teresa", "destination": "/shuttle/liberia-airport-to-santa-teresa", "permanent": true },
    { "source": "/private-shuttle/la-fortuna-arenal/monteverde", "destination": "/shuttle/la-fortuna-to-monteverde", "permanent": true },
    { "source": "/private-shuttle/la-fortuna-arenal/manuel-antonio", "destination": "/shuttle/la-fortuna-to-manuel-antonio", "permanent": true },
    { "source": "/private-shuttle/la-fortuna-arenal/tamarindo", "destination": "/shuttle/la-fortuna-to-tamarindo", "permanent": true },
    { "source": "/private-shuttle/la-fortuna-arenal/sjo-airport", "destination": "/shuttle/la-fortuna-to-san-jose-airport", "permanent": true },
    { "source": "/private-shuttle/la-fortuna-arenal/liberia-airport", "destination": "/shuttle/la-fortuna-to-liberia-airport", "permanent": true },
    { "source": "/private-shuttle/monteverde/la-fortuna-arenal", "destination": "/shuttle/monteverde-to-la-fortuna", "permanent": true },
    { "source": "/private-shuttle/monteverde/manuel-antonio", "destination": "/shuttle/monteverde-to-manuel-antonio", "permanent": true },
    { "source": "/private-shuttle/manuel-antonio/sjo-airport", "destination": "/shuttle/manuel-antonio-to-san-jose-airport", "permanent": true },
    { "source": "/private-shuttle/manuel-antonio/la-fortuna-arenal", "destination": "/shuttle/manuel-antonio-to-la-fortuna", "permanent": true },
    { "source": "/private-shuttle/tamarindo/lir-airport", "destination": "/shuttle/tamarindo-to-liberia-airport", "permanent": true },
    { "source": "/private-shuttle/tamarindo/la-fortuna-arenal", "destination": "/shuttle/tamarindo-to-la-fortuna", "permanent": true },

    { "source": "/private-shuttle/sjo-airport/:dest*", "destination": "/#routes", "permanent": true },
    { "source": "/private-shuttle/lir-airport/:dest*", "destination": "/#routes", "permanent": true },
    { "source": "/private-shuttle/:path*", "destination": "/#routes", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/enviarResenas", "schedule": "0 15 * * *" }
  ]
}
